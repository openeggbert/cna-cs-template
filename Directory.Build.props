<Project>
  <!-- Repository-only convenience. .template.config excludes this file from generated games. -->
  <PropertyGroup>
    <CnaCsRoot Condition="'$(CnaCsRoot)' == '' and Exists('$(MSBuildThisFileDirectory)..\cna-cs\src\CNA.XnaCompat\CNA.XnaCompat.csproj')">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\cna-cs'))</CnaCsRoot>
  </PropertyGroup>
</Project>
