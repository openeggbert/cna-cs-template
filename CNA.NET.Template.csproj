<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Not CNA.NET.Template: that namespace nests under CNA, which collides with cna-cs's own
         root CNA namespace and makes bare Game/Color/PlayerIndex (etc.) resolve to CNA's own
         types instead of Microsoft.Xna.Framework's compat ones, even with `using
         Microsoft.Xna.Framework;` in scope: an enclosing namespace's members shadow a using
         directive's imports in C#. -->
    <RootNamespace>CnaCsTemplate</RootNamespace>
    
    <!-- Engine selection: CNA, MonoGame, FNA, or Kni -->
    <Engine Condition="'$(Engine)' == ''">CNA</Engine>
  </PropertyGroup>

  <!-- Conditional Constants -->
  <PropertyGroup Condition="'$(Engine)' == 'CNA'">
    <DefineConstants>$(DefineConstants);ENGINE_CNA</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Engine)' == 'MonoGame'">
    <DefineConstants>$(DefineConstants);ENGINE_MONOGAME</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Engine)' == 'FNA'">
    <DefineConstants>$(DefineConstants);ENGINE_FNA</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Engine)' == 'Kni'">
    <DefineConstants>$(DefineConstants);ENGINE_KNI</DefineConstants>
  </PropertyGroup>

  <!-- Package/Reference selection -->
  <ItemGroup Condition="'$(Engine)' == 'CNA'">
    <!-- No published CNA.Framework NuGet package exists yet, so this references the sibling
         cna-cs checkout directly. CNA.XnaCompat pulls in CNA.Framework transitively. -->
    <ProjectReference Include="..\cna-cs\src\CNA.XnaCompat\CNA.XnaCompat.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(Engine)' == 'MonoGame'">
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.1.303" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.1.303" />
  </ItemGroup>

  <ItemGroup Condition="'$(Engine)' == 'FNA'">
    <!-- Assuming FNA is locally available or linked as a project -->
    <Reference Include="FNA">
      <HintPath>libs\FNA.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!--
    Both pinned to the same version. They were 3.9.1, and nkast.Xna.Framework.Content 3.9.1
    resolves to 3.11.9001, which drags nkast.Xna.Framework up with it; that is a package downgrade
    and NU1605 turns it into an error. So Engine=Kni did not build at all while the README listed
    it as supported.
  -->
  <ItemGroup Condition="'$(Engine)' == 'Kni'">
    <PackageReference Include="nkast.Xna.Framework" Version="3.12.9001" />
    <PackageReference Include="nkast.Xna.Framework.Content" Version="3.12.9001" />
    <PackageReference Include="nkast.Xna.Framework.Graphics" Version="3.12.9001" />
    <PackageReference Include="nkast.Xna.Framework.Input" Version="3.12.9001" />
    <PackageReference Include="nkast.Xna.Framework.Game" Version="3.12.9001" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Content\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
